ws = "DIST-LTV-STG-0418000020BH"
lakehouses = ["CLV_lakehouse_spl_STG", "CLV_lakehouse_asc_spl_STG", "NB_SPL_Lakehouse"]

def walk(path, hits, depth=0):
    try:
        items = notebookutils.fs.ls(path)
    except Exception as e:
        print("  cannot read:", path.split("/Files")[-1] or "/", type(e).__name__)
        return
    for it in items:
        if it.isDir:
            if "=" not in it.name and depth < 8:  # skip parquet partition folders
                walk(it.path, hits, depth + 1)
        elif it.name.lower().endswith((".xlsx", ".xls")):
            hits.append(it.path.split("/Files/")[-1])

for lh in lakehouses:
    root = f"abfss://{ws}@onelake.dfs.fabric.microsoft.com/{lh}.Lakehouse/Files"
    hits = []
    walk(root, hits)
    print(f"{lh}: {len(hits)} Excel files")
    for h in hits:
        print("   ", h)
